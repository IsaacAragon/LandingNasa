# Cloudflare Workers Static Assets: cabeceras por ruta

# Archivos con hash de Vite: nunca cambian, se cachean un año
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Íconos: sin hash, así que caché corta para que un cambio de logo se vea pronto
/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
/icon-*.png
  Cache-Control: public, max-age=3600, must-revalidate
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600, must-revalidate
